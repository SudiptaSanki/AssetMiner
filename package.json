{
  "name": "asset-miner",
  "version": "0.1.0",
  "private": true,
  "description": "Progressive project source recovery, asset extraction and verified export. Local-first browser extension (Manifest V3).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts && node scripts/sync-loadable.mjs",
    "sync": "node scripts/sync-loadable.mjs",
    "watch": "vite build --watch",
    "icons": "node scripts/gen-icons.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.4",
    "happy-dom": "^17.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
